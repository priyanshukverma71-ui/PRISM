// PRISM Regulatory Intelligence Platform - PostgreSQL Prisma Schema for Production / Docker

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String      @id @default(uuid())
  email          String      @unique
  passwordHash   String
  name           String
  role           String      // INSTITUTION_USER, REGIONAL_OFFICER, BUREAU_OFFICER, COMMITTEE_REVIEWER, SYSTEM_ADMIN, AUDITOR
  institutionId  String?
  region         String?
  status         String      @default("ACTIVE")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  institution    Institution? @relation(fields: [institutionId], references: [id])
  assignments    CaseAssignment[] @relation("AssignedTo")
  givenAssignments CaseAssignment[] @relation("AssignedBy")
  submissions    ComplianceSubmission[]
  evcCommittees  EVCVisit[]   @relation("CommitteeLead")

  @@index([role])
  @@index([region])
}

model Institution {
  id             String      @id @default(uuid())
  code           String      @unique
  name           String
  type           String
  region         String
  address        String
  contactEmail   String
  contactPhone   String
  accreditation  String?
  status         String      @default("ACTIVE")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  users          User[]
  applications   Application[]
  obligations    ComplianceObligation[]
  submissions    ComplianceSubmission[]
  documents      DocumentRecord[]

  @@index([code])
  @@index([region])
}

model WorkflowTemplate {
  id             String      @id @default(uuid())
  code           String      @unique
  name           String
  description    String
  activeVersion  Int         @default(1)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  versions       WorkflowVersion[]
  applications   Application[]
}

model WorkflowVersion {
  id               String           @id @default(uuid())
  templateId       String
  versionNumber    Int
  isPublished      Boolean          @default(false)
  publishedAt      DateTime?
  publishedBy      String?
  changeSummary    String?
  stagesJson       String
  transitionsJson  String
  createdAt        DateTime         @default(now())

  template         WorkflowTemplate @relation(fields: [templateId], references: [id])
  applications     Application[]

  @@unique([templateId, versionNumber])
}

model Application {
  id                   String           @id @default(uuid())
  applicationNumber    String           @unique
  institutionId        String
  region               String
  category             String
  academicYear         String           @default("2025-2026")
  workflowTemplateId   String
  workflowVersionId    String
  currentStage         String
  status               String           @default("IN_PROGRESS")
  priority             String           @default("NORMAL")
  riskScore            Float            @default(0.0)
  riskCategory         String           @default("LOW")
  riskFactorsJson      String           @default("[]")
  assignedOfficerId    String?
  submissionDate       DateTime         @default(now())
  stageEntryDate       DateTime         @default(now())
  deadlineDate         DateTime?
  observations         String?
  returnReason         String?
  metadataJson         String           @default("{}")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  institution          Institution      @relation(fields: [institutionId], references: [id])
  workflowTemplate     WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id])
  workflowVersion      WorkflowVersion  @relation(fields: [workflowVersionId], references: [id])
  stageHistories       StageHistory[]
  assignments          CaseAssignment[]
  evcVisits            EVCVisit[]
  complianceObligations ComplianceObligation[]
  documentRecords      DocumentRecord[]
  alerts               Alert[]

  @@index([applicationNumber])
  @@index([institutionId])
  @@index([region])
  @@index([currentStage])
  @@index([status])
  @@index([riskCategory])
  @@index([deadlineDate])
}

model StageHistory {
  id                  String       @id @default(uuid())
  applicationId       String
  fromStage           String
  toStage             String
  actorId             String
  actorRole           String
  action              String
  comments            String?
  prerequisitesCheck  String?
  durationHours       Float?
  createdAt           DateTime     @default(now())

  application         Application  @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
}

model CaseAssignment {
  id             String       @id @default(uuid())
  applicationId  String
  assignedToId   String
  assignedById   String
  role           String
  assignedAt     DateTime     @default(now())
  dueAt          DateTime?
  status         String       @default("ACTIVE")
  notes          String?

  application    Application  @relation(fields: [applicationId], references: [id])
  assignedTo     User         @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedBy     User         @relation("AssignedBy", fields: [assignedById], references: [id])

  @@index([applicationId])
  @@index([assignedToId])
}

model EVCVisit {
  id                     String       @id @default(uuid())
  applicationId          String
  visitType              String       @default("REGULAR")
  status                 String       @default("PENDING_SCHEDULE")
  scheduledDate          DateTime?
  completedDate          DateTime?
  schedulingDeadline     DateTime?
  committeeLeadId        String?
  committeeMembersJson   String       @default("[]")
  findings               String?
  reportHash             String?
  reportReference        String?
  reschedulingReason     String?
  prerequisitesSatisfied Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  application            Application  @relation(fields: [applicationId], references: [id])
  committeeLead          User?        @relation("CommitteeLead", fields: [committeeLeadId], references: [id])

  @@index([applicationId])
  @@index([status])
  @@index([scheduledDate])
}

model ComplianceObligation {
  id                 String       @id @default(uuid())
  institutionId      String
  applicationId      String?
  title              String
  category           String
  description        String
  prescribedDocType  String
  dueDate            DateTime
  warningDate        DateTime?
  status             String       @default("PENDING")
  severity           String       @default("HIGH")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  institution        Institution  @relation(fields: [institutionId], references: [id])
  application        Application? @relation(fields: [applicationId], references: [id])
  submissions        ComplianceSubmission[]
  alerts             Alert[]

  @@index([institutionId])
  @@index([applicationId])
  @@index([status])
  @@index([dueDate])
}

model ComplianceSubmission {
  id              String               @id @default(uuid())
  obligationId    String
  institutionId   String
  submittedById   String
  submissionDate  DateTime             @default(now())
  docCategory     String
  documentUrl     String?
  fileHash        String
  fileName        String
  fileSize        Int
  version         Int                  @default(1)
  status          String               @default("PENDING_VERIFICATION")
  reviewerId      String?
  reviewComments  String?
  reviewedAt      DateTime?
  createdAt       DateTime             @default(now())

  obligation      ComplianceObligation @relation(fields: [obligationId], references: [id])
  institution     Institution          @relation(fields: [institutionId], references: [id])
  submittedBy     User                 @relation(fields: [submittedById], references: [id])

  @@index([obligationId])
  @@index([institutionId])
  @@index([status])
}

model DocumentRecord {
  id                  String       @id @default(uuid())
  institutionId       String
  applicationId       String?
  title               String
  category            String
  issueDate           DateTime?
  expiryDate          DateTime?
  storageKey          String
  fileHash            String
  fileName            String
  fileSize            Int
  verificationStatus  String       @default("PENDING")
  reviewerId          String?
  reviewComments      String?
  metadataJson        String       @default("{}")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  institution         Institution  @relation(fields: [institutionId], references: [id])
  application         Application? @relation(fields: [applicationId], references: [id])

  @@index([institutionId])
  @@index([applicationId])
  @@index([expiryDate])
  @@index([verificationStatus])
}

model Alert {
  id                String       @id @default(uuid())
  eventKey          String       @unique
  recipientRole     String?
  recipientId       String?
  applicationId     String?
  obligationId      String?
  title             String
  message           String
  severity          String       @default("MEDIUM")
  alertType         String
  status            String       @default("UNRESOLVED")
  resolvedAt        DateTime?
  resolvedById      String?
  escalationLevel   Int          @default(1)
  metadataJson      String       @default("{}")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  application       Application?          @relation(fields: [applicationId], references: [id])
  obligation        ComplianceObligation? @relation(fields: [obligationId], references: [id])
  deliveryAttempts  AlertDeliveryAttempt[]
  escalations       EscalationEvent[]

  @@index([status])
  @@index([severity])
  @@index([recipientRole])
  @@index([applicationId])
}

model AlertDeliveryAttempt {
  id           String       @id @default(uuid())
  alertId      String
  channel      String
  destination  String
  status       String
  error        String?
  attemptedAt  DateTime     @default(now())

  alert        Alert        @relation(fields: [alertId], references: [id])

  @@index([alertId])
}

model EscalationEvent {
  id               String       @id @default(uuid())
  alertId          String
  fromLevel        Int
  toLevel          Int
  escalatedToRole  String
  escalatedToId    String?
  reason           String
  createdAt        DateTime     @default(now())

  alert            Alert        @relation(fields: [alertId], references: [id])

  @@index([alertId])
}

model AuditEvent {
  id              String       @id @default(uuid())
  sequenceIndex   Int
  correlationId   String
  actorId         String
  actorName       String
  actorRole       String
  actionType      String
  targetType      String
  targetId        String
  previousState   String?
  newState        String?
  reason          String?
  documentHash    String?
  ruleVersion     String?
  currentHash     String
  previousHash    String
  createdAt       DateTime     @default(now())

  @@index([sequenceIndex])
  @@index([correlationId])
  @@index([actionType])
  @@index([targetId])
  @@index([createdAt])
}

model SimulationScenario {
  id                   String       @id @default(uuid())
  name                 String
  description          String?
  createdById          String
  baseApplicationId    String
  parametersJson       String
  resultsJson          String
  createdAt            DateTime     @default(now())

  @@index([baseApplicationId])
  @@index([createdById])
}

model RuleDraft {
  id                   String       @id @default(uuid())
  ruleId               String       @unique
  sourceDoc            String
  sourceVersion        String
  pageRef              String?
  sectionRef           String?
  title                String
  extractedText        String
  conditionJson        String
  actionJson           String
  timelineDays         Int?
  prerequisitesJson    String       @default("[]")
  confidenceScore      Float        @default(0.95)
  notes                String?
  status               String       @default("DRAFT")
  reviewerId           String?
  reviewComments       String?
  publishedVersionId   String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([ruleId])
  @@index([status])
}
